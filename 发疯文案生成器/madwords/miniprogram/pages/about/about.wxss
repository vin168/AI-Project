.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #0b0b12;
  color: #fff;
}

.card {
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.text {
  margin-top: 16rpx;
  line-height: 1.8;
  color: #d0d0e8;
}
