.moments-page {
  min-height: 100vh;
  padding: 36rpx 30rpx 56rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(255, 214, 231, 0.72) 0, rgba(255, 214, 231, 0.72) 16%, transparent 17%),
    radial-gradient(circle at top right, rgba(186, 230, 253, 0.72) 0, rgba(186, 230, 253, 0.72) 14%, transparent 15%),
    linear-gradient(180deg, #fff9fd 0%, #f2fbff 48%, #ffffff 100%);
  color: #20304a;
}

.moments-page .hero {
  padding: 44rpx 0 28rpx;
  text-align: center;
  position: relative;
}

.moments-page .badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(99, 102, 241, 0.12);
  color: #5b6cf2;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.moments-page .title {
  margin-top: 20rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.moments-page .subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5f6f8a;
}

.moments-page .tips {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7b8aa6;
}

.moments-page .card,
.moments-page .result-card {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(90, 116, 190, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 38rpx rgba(96, 123, 177, 0.12);
  backdrop-filter: blur(18rpx);
}

.moments-page .card-tight-top {
  margin-top: 0;
}

.moments-page .section-head {
  margin-bottom: 12rpx;
}

.moments-page .style-select-hint {
  margin-top: 6rpx;
  margin-bottom: 22rpx;
}

.moments-page .section-head,
.moments-page .history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.moments-page .style-list {
  margin-top: 4rpx;
}

.moments-page .section-title,
.moments-page .result-title {
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.moments-page .clear-btn,
.moments-page .section-meta,
.moments-page .result-tag,
.moments-page .history-time,
.moments-page .history-style {
  font-size: 22rpx;
  color: #bdb4ff;
}

.moments-page .clear-btn {
  color: #f9a8d4;
}

.moments-page .scene-desc,
.moments-page .style-select-hint,
.moments-page .option-label {
  color: #7182a1;
  font-size: 20rpx;
}

.moments-page .style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.moments-page .style-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #3f4b66;
  border: 1rpx solid rgba(153, 181, 255, 0.18);
  font-size: 22rpx;
}

.moments-page .style-item.active {
  background: linear-gradient(135deg, #ff8fc7, #7dd3fc);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 14rpx 28rpx rgba(255, 143, 199, 0.22);
}

.moments-page .input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(153, 181, 255, 0.22);
  color: #20304a;
  font-size: 26rpx;
}

.moments-page .input::placeholder {
  color: rgba(87, 102, 128, 0.5);
}

.moments-page .custom-input-wrap {
  margin-top: 14rpx;
}

.moments-page .option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(153, 181, 255, 0.12);
}

.moments-page .option-row:first-of-type {
  margin-top: 10rpx;
  border-top: none;
  padding-top: 8rpx;
}

.moments-page .option-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.moments-page .option-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.moments-page .option-desc {
  font-size: 20rpx;
  color: #8a98b2;
  line-height: 1.5;
}

.moments-page .segmented {
  display: inline-flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 214, 231, 0.45);
}

.moments-page .segmented-item {
  min-width: 96rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #3d4f6c;
  font-size: 22rpx;
}

.moments-page .segmented-item.active {
  background: linear-gradient(135deg, #ff8fc7, #7dd3fc);
  color: #fff;
}

.moments-page .moments-btn {
  margin-top: 28rpx;
  height: 86rpx;
  line-height: 86rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8fc7, #7dd3fc);
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(255, 143, 199, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.moments-page .moments-btn.is-loading {
  opacity: 0.85;
}

.moments-page .btn-hover {
  transform: scale(0.99);
  opacity: 0.96;
}

.moments-page .result-card {
  margin-top: 22rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(245, 251, 255, 0.96));
}

.moments-page .result-title {
  color: #334155;
}

.moments-page .result-tag {
  background: rgba(255, 143, 199, 0.14);
  color: #d63384;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.moments-page .scene-desc {
  margin-top: 12rpx;
}

.moments-page .result-text {
  color: #20304a;
  white-space: pre-wrap;
  line-height: 1.8;
  min-height: 120rpx;
  font-size: 28rpx;
}

.moments-page .actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  justify-content: center;
}

.moments-page .actions button {
  flex: 0 0 180rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.moments-page .actions button:first-child {
  background: rgba(96, 123, 177, 0.1);
  color: #334155;
  border: 1rpx solid rgba(153, 181, 255, 0.18);
}

.moments-page .actions button:last-child {
  background: linear-gradient(135deg, #ff8fc7, #ffb7d9);
  color: #fff;
  border: none;
}

.moments-page .history-card {
  padding-bottom: 18rpx;
}

.moments-page .history-item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(153, 181, 255, 0.12);
}

.moments-page .history-item:first-child {
  padding-top: 0;
  border-top: none;
}

.moments-page .history-top {
  gap: 16rpx;
}

.moments-page .history-style {
  font-size: 22rpx;
  color: #334155;
  font-weight: 600;
  flex: 1;
}

.moments-page .history-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.moments-page .history-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #42526b;
  line-height: 1.7;
  white-space: pre-wrap;
}