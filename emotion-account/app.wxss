/* 情绪账本 - 全局样式 */
/* 温柔治愈风：莫兰迪低饱和色、圆角卡片、无冗余元素 */

/* 颜色规范 */
:root {
  --primary-color: #FFB6C1; /* 浅粉色 */
  --secondary-color: #87CEEB; /* 浅蓝色 */
  --background-color: #F9F9F9;
  --card-background: #FFFFFF;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #E8E8E8;
  --shadow-color: rgba(0, 0, 0, 0.05);

  /* 情绪标签颜色 */
  --emotion-happy: #FFD700; /* 开心犒劳 - 暖黄色 */
  --emotion-pain: #DDA0DD; /* 心疼肉痛 - 浅紫色 */
  --emotion-impulse: #FF6B6B; /* 冲动后悔 - 红色 */
  --emotion-necessary: #A9A9A9; /* 无奈必需 - 灰色 */
  --emotion-heal: #ADD8E6; /* 治愈安慰 - 浅蓝色 */
  --emotion-worth: #98FB98; /* 值得投资 - 绿色 */
}

/* 基础重置 */
page {
  background-color: var(--background-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  color: var(--text-primary);
  font-size: 14px;
  line-height: 1.5;
  height: 100%;
}

/* 容器 */
.container {
  padding: 15px;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF; /* 回退 */
  background-color: var(--card-background);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 15px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); /* 回退 */
  box-shadow: 0 2px 8px var(--shadow-color);
}

/* 按钮样式 */
.btn {
  border-radius: 24px;
  padding: 12px 24px;
  text-align: center;
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: var(--primary-color);
  color: white;
}

.btn-secondary {
  background-color: var(--secondary-color);
  color: white;
}

/* 输入框样式 */
.input {
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 12px;
  font-size: 16px;
  background-color: white;
}

.input:focus {
  border-color: var(--primary-color);
  outline: none;
}

/* 金额字体 */
.amount {
  font-weight: bold;
  font-size: 24px;
}

/* 情绪标签 */
.emotion-tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 16px;
  font-size: 12px;
  margin-right: 8px;
  margin-bottom: 8px;
}

.emotion-happy {
  background-color: var(--emotion-happy);
  color: #333;
}

.emotion-pain {
  background-color: var(--emotion-pain);
  color: white;
}

.emotion-impulse {
  background-color: var(--emotion-impulse);
  color: white;
}

.emotion-necessary {
  background-color: var(--emotion-necessary);
  color: white;
}

.emotion-heal {
  background-color: var(--emotion-heal);
  color: #333;
}

.emotion-worth {
  background-color: var(--emotion-worth);
  color: #333;
}

/* 分类图标 */
.category-icon {
  width: 24px;
  height: 24px;
  margin-right: 8px;
}

/* 弹性布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 间距工具 */
.mt-10 { margin-top: 10px; }
.mb-10 { margin-bottom: 10px; }
.ml-10 { margin-left: 10px; }
.mr-10 { margin-right: 10px; }

.pt-10 { padding-top: 10px; }
.pb-10 { padding-bottom: 10px; }
.pl-10 { padding-left: 10px; }
.pr-10 { padding-right: 10px; }

/* 文字工具 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-bold { font-weight: bold; }
.text-light { color: var(--text-light); }

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

.bounce {
  animation: bounce 0.5s ease;
}