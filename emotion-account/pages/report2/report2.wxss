/* 报告页样式 */

.report-shell {
  padding-bottom: 24px;
}

.report-shell .container {
  padding: 12px 12px 18px;
}

.report-shell .card {
  position: relative;
  overflow: hidden;
  border-radius: 22px;
  border: 1px solid rgba(255, 183, 198, 0.28);
  box-shadow: 0 12px 28px rgba(179, 122, 136, 0.08);
  margin-bottom: 16px;
  padding: 18px 16px 16px;
  background: linear-gradient(135deg, #fff7fb 0%, #ffe5ee 48%, #fff9f2 100%);
}

.report-hero {
  padding: 20px 18px 18px;
}

.loading,
.empty-state {
  margin-top: 18px;
  padding: 42px 18px;
  text-align: center;
  color: #8d7b84;
}

.loading-text {
  font-size: 14px;
  color: #7b6771;
}

.report-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.empty-badge {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 8px 18px rgba(160, 120, 132, 0.06);
}

.message-text {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #3a2d33;
}

.tip-text {
  font-size: 12px;
  color: #8d7b84;
  line-height: 1.5;
}

.report-hero-top,
.emotion-row,
.highlight-row,
.impulse-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.report-hero-badge,
.emotion-badge {
  width: 58px;
  height: 58px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  background: rgba(255, 255, 255, 0.78);
  flex-shrink: 0;
}

.report-hero-copy,
.emotion-body,
.highlight-copy {
  flex: 1;
}

.report-hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.report-hero-tag {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.82);
  color: #8d7b84;
  font-size: 11px;
}

.report-title {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #3a2d33;
  line-height: 1.2;
}

.report-subtitle,
.report-hero-note,
.report-meta-chip,
.section-title,
.stat-item .label,
.stat-item .value,
.emotion-percentage,
.record-note,
.impulse-date,
.heal-item .label {
  color: #7b6771;
}

.report-hero-note {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.78);
}

.report-hero-note text {
  font-size: 13px;
  line-height: 1.7;
  color: #7a2f4e;
}

.report-hero-rail {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 14px;
}

.report-hero-rail-item {
  flex: 1 1 92px;
  min-width: 92px;
  padding: 10px 12px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.76);
}

.report-hero-rail-item.emphasis {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 239, 245, 0.96) 100%);
}

.rail-label {
  display: block;
  font-size: 11px;
  color: #8d7b84;
  margin-bottom: 4px;
}

.rail-value {
  display: block;
  font-size: 13px;
  line-height: 1.5;
  color: #3a2d33;
  font-weight: 600;
}

.report-meta-row,
.stats-grid,
.heal-grid {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.summary-card,
.top-emotion-card,
.highlight-row,
.heal-grid {
  margin-top: 2px;
}

.summary-card .stats-grid,
.heal-grid {
  gap: 12px;
}

.report-meta-chip,
.stat-item,
.heal-item {
  padding: 10px 12px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.76);
}

.section-title {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: #6d5663;
  margin-bottom: 10px;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.68);
}

.stat-item,
.heal-item {
  flex: 1;
  text-align: center;
}

.stat-item .value,
.emotion-amount,
.record-amount,
.impulse-amount {
  color: #7a2f4e;
  font-weight: 700;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.record-card-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 0;
}

.category-icon {
  font-size: 22px;
}

.category-name,
.emotion-name {
  display: block;
  color: #3a2d33;
  font-weight: 600;
}
