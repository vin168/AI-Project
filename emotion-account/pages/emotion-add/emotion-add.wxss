.container {
  padding: 15px;
}

.card {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 12px;
}

.form-input {
  width: 100%;
  height: 44px;
  border: 1px solid #e8e8e8;
  border-radius: 10px;
  padding: 0 12px;
  font-size: 14px;
  background-color: #ffffff;
}

.placeholder {
  color: #999999;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-top: 8px;
}

.color-item {
  width: 100%;
  height: 44px;
  border-radius: 12px;
  border: 2px solid transparent;
  box-sizing: border-box;
}

.color-item.active {
  border-color: #333333;
  box-shadow: 0 0 0 3px rgba(255, 182, 193, 0.25);
}

.color-preview-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.preview-label,
.preview-value {
  font-size: 13px;
  color: #666666;
}

.color-preview {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1px solid #dddddd;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 8px;
}

.icon-item {
  width: 64px;
  height: 64px;
  border-radius: 14px;
  border: 1px solid #f0f0f0;
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
}

.icon-item.active {
  border-color: #ffb6c1;
  background-color: #fff0f5;
}

.icon-emoji {
  font-size: 28px;
  line-height: 1;
}

.action-row {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.btn {
  flex: 1;
  height: 44px;
  border-radius: 12px;
  border: 1px solid #d0d0d0;
  background-color: #ffffff;
  font-size: 14px;
}

.btn.primary {
  border: none;
  background: linear-gradient(135deg, #ff9a9e, #fecfef);
  color: #ffffff;
}
