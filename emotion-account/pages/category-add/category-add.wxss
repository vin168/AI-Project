.container {
  padding: 15px;
}

.card {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 12px;
}

.form-input {
  width: 100%;
  height: 44px;
  border: 1px solid #e8e8e8;
  border-radius: 10px;
  padding: 0 12px;
  font-size: 14px;
  background-color: #ffffff;
}

.placeholder {
  color: #999999;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
  gap: 12px;
  margin-top: 8px;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15px 5px;
  border-radius: 12px;
  background-color: #f8f8f8;
  color: #333333;
  transition: all 0.3s ease;
}

.category-item.selected {
  background-color: #ffb6c1;
  color: #111111;
  transform: scale(1.08);
  box-shadow: 0 6px 16px rgba(255, 182, 193, 0.35);
}

.category-icon {
  font-size: 24px;
  margin-bottom: 0;
}

.action-row {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.btn {
  flex: 1;
  height: 44px;
  border-radius: 12px;
  border: 1px solid #d0d0d0;
  background-color: #ffffff;
  font-size: 14px;
}

.btn.primary {
  border: none;
  background: linear-gradient(135deg, #ff9a9e, #fecfef);
  color: #ffffff;
}
